# Required
DTRACK_URL=https://dependency-track.example.com
DTRACK_API_KEY=your-api-key-here

# Optional
SCAN_INTERVAL=0 */6 * * *    # Cron expression (default: every 6 hours)
SCAN_ON_START=true           # Run scan on container start
EXCLUDE_IMAGES=scanner,dtrack  # Comma-separated image name patterns to skip
DTRACK_PARENT_PROJECT=       # Optional parent project name in Dependency-Track
SCANNER_HOSTNAME=            # Override hostname (default: container hostname)
CLEANUP_STALE=true           # Remove projects for containers no longer running on this host
PROJECT_PREFIX=zzz-docker/   # Prefix for project names (sorts last alphabetically)
TZ=UTC                       # Timezone for cron
