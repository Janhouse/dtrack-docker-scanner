# Required
# Dependency-Track API URL
DTRACK_URL=https://dependency-track.example.com
# API key with permissions to create/update projects and upload BOMs
DTRACK_API_KEY=your-api-key-here

# Optional - Scanner behavior
# Cron expression for scheduled scans (default: every 6 hours)
SCAN_INTERVAL=0 */6 * * *
# Run scan on container start
SCAN_ON_START=true
# Number of concurrent SBOM uploads
SCAN_CONCURRENCY=2
# Watch Docker events for new containers
WATCH_DOCKER=true

# Optional - Image filtering
# Comma-separated image name patterns to skip
EXCLUDE_IMAGES=scanner,dtrack

# Optional - Dependency-Track organization
# Parent project name to group containers under
DTRACK_PARENT_PROJECT=
# Override hostname (default: container hostname)
SCANNER_HOSTNAME=

# Optional - Cleanup behavior
# Remove projects for containers no longer running
CLEANUP_STALE=true
# How long to cache scanned image hashes (minutes)
CACHE_TTL_MINUTES=60
# Mark project inactive after container stopped this long (minutes)
INACTIVE_AFTER_MINUTES=60
# Delay cleanup after initial scan (minutes)
INITIAL_CLEANUP_DELAY_MINUTES=3

# Optional - Timezone
# Timezone for cron schedule
TZ=UTC

# Optional - Scan sources
# Scan running Docker containers (via /var/run/docker.sock). Default: true.
SCAN_DOCKER=true
# Also scan Kubernetes pods on this node (via the in-cluster kube API). Default:
# false. Intended for running the scanner as a DaemonSet in a cluster.
SCAN_KUBERNETES=false

# Optional - Kubernetes (only used when SCAN_KUBERNETES=true)
# Restrict to pods scheduled on this node. In a DaemonSet, set from the downward
# API: valueFrom.fieldRef.fieldPath=spec.nodeName. Empty => all visible pods.
KUBE_NODE_NAME=
# Only scan these namespaces (comma-separated). Empty => all visible to the token.
KUBE_NAMESPACES=
# Trivy image source for k8s images. "containerd" (default) scans images already
# present on the node via the containerd socket (no registry creds needed) — set
# CONTAINERD_ADDRESS/CONTAINERD_NAMESPACE and mount the socket. Use "remote" to
# pull from the registry instead.
TRIVY_K8S_IMAGE_SRC=containerd
# When TRIVY_K8S_IMAGE_SRC=containerd, point Trivy at the node's containerd. For
# k3s: /run/k3s/containerd/containerd.sock + namespace k8s.io (mount the socket).
# CONTAINERD_ADDRESS=/run/k3s/containerd/containerd.sock
# CONTAINERD_NAMESPACE=k8s.io
