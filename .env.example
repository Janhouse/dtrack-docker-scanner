# Required
# Dependency-Track API URL
DTRACK_URL=https://dependency-track.example.com
# API key with permissions to create/update projects and upload BOMs
DTRACK_API_KEY=your-api-key-here

# Optional - Scanner behavior
# Cron expression for scheduled scans (default: every 6 hours)
SCAN_INTERVAL=0 */6 * * *
# Run scan on container start
SCAN_ON_START=true
# Number of concurrent SBOM uploads
SCAN_CONCURRENCY=2
# Watch Docker events for new containers
WATCH_DOCKER=true

# Optional - Image filtering
# Comma-separated image name patterns to skip
EXCLUDE_IMAGES=scanner,dtrack

# Optional - Dependency-Track organization
# Parent project name to group containers under
DTRACK_PARENT_PROJECT=
# Override hostname (default: container hostname)
SCANNER_HOSTNAME=

# Optional - Cleanup behavior
# Remove projects for containers no longer running
CLEANUP_STALE=true
# How long to cache scanned image hashes (minutes)
CACHE_TTL_MINUTES=60
# Mark project inactive after container stopped this long (minutes)
INACTIVE_AFTER_MINUTES=60
# Delay cleanup after initial scan (minutes)
INITIAL_CLEANUP_DELAY_MINUTES=3

# Optional - Timezone
# Timezone for cron schedule
TZ=UTC
