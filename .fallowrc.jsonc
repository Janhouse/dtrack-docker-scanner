{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Entry points and workspaces are auto-detected (Next.js plugin +
  // package.json), so no manual "entry"/"workspaces" list is needed.
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste.
    "minOccurrences": 3
  },
  // DockerClient event-listener methods are invoked from src/index.ts via a
  // chained getter call (`scanner.getDockerClient().startEventListener(...)`),
  // which the static class-member analysis cannot resolve. They are real,
  // used API, so suppress the false-positive unused-class-member findings.
  "usedClassMembers": ["startEventListener", "stopEventListener"],
  "rules": {
    "unused-dependencies": "warn"
  },
  // DockerEventCallback is re-exported from the clients barrel as part of the
  // public API and is consumed internally by docker.ts; keep the barrel export.
  "ignoreExports": [
    {
      "file": "src/clients/index.ts",
      "exports": ["DockerEventCallback"]
    }
  ],
  // Class members the static tracer cannot follow through accessor call-chains
  // (scanner.getDockerClient().startEventListener()/.stopEventListener()), plus
  // the ImageCache public get/clear API.
  "usedClassMembers": [
    "startEventListener",
    "stopEventListener",
    "get",
    "clear"
  ]
}
